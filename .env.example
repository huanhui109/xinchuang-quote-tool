# ---- 服务监听 ----
# 监听地址。默认仅本机可访问；确需对外暴露再设为 0.0.0.0（注意自担风险）
HOST=127.0.0.1
# 监听端口。被占用时服务自动顺延到 8001、8002… 并在启动日志提示实际端口
PORT=8000

# ---- 数据目录 ----
# 数据落盘目录（store.json、备份、埋点事件文件）。不设置时用 <项目根>/data
# 测试隔离时可用它指向临时目录，避免污染真实数据
# STORE_DATA_DIR=/tmp/xcq-data

# ---- 请求与事件流 ----
# REST 请求体上限（字节）。默认 32MB，防止超大 JSON 打满内存
# MAX_BODY_BYTES=33554432
# 埋点事件文件单文件体积上限（字节），超出自动轮转。默认 10MB
# EVENTS_MAX_BYTES=10485760
# 埋点事件文件保留份数
# EVENTS_KEEP=10

# ---- 架构图（draw.io）----
# 架构图编辑器地址。内网 / 离线环境可指向自建 drawio 静态服务
# DRAWIO_EMBED_URL=https://embed.diagrams.net/
# draw.io 加载超时（毫秒），超时自动降级到内置离线编辑器
# DRAWIO_LOAD_TIMEOUT_MS=12000
# 架构图 XML 体积上限（字节）。默认 8MB
# MAX_ARCH_XML_BYTES=8388608

# ---- 硬件清单解析上限 ----
# 单次上传体积上限（字节）。默认 8MB
# HCL_MAX_UPLOAD_BYTES=8388608
# 单表读取行数 / 列数上限，超出截断并告警
# HCL_MAX_ROWS=5000
# HCL_MAX_COLS=60
# 单文件工作表数量上限
# HCL_MAX_SHEETS=8
# 解压预算（字节）与 zip 条目数上限 —— 解压炸弹防护
# HCL_MAX_UNZIP_BYTES=33554432
# HCL_MAX_ZIP_ENTRIES=200
# 规格模板 + 已选配置状态上限（字节）。默认 4MB
# HCL_MAX_STATE_BYTES=4194304

# ---- 测试相关 ----
# 测试脚本调用的 Python 解释器（tools/test-backend.js 使用）
# PYTHON_BIN=python3
